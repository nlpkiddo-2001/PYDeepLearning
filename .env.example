# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ─── Zoho LLM Configuration ────────────────────────────────────
# ZOHO_LLM_URL: Internal Zoho LLM endpoint
# ZOHO_AUTH_TOKEN: Session or authentication cookie for Zoho LLM
ZOHO_LLM_URL="https://your-zoho-instance.kites.localzoho.com/llm/text/api/endpoint"
ZOHO_AUTH_TOKEN="your-session-token-here"

# ─── LLM Providers ─────────────────────────────────────────────
# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Anthropic (Claude)
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini
GOOGLE_API_KEY="AIzaSy..."

# ─── Third-Party Job APIs ─────────────────────────────────────
# Adzuna Job Search API
ADZUNA_APP_ID="your-app-id"
ADZUNA_APP_KEY="your-app-key"
ADZUNA_COUNTRY="us"

# RapidAPI Key (for JSearch and other APIs)
RAPIDAPI_KEY="your-rapidapi-key"
RAPIDAPI_HOST="jsearch.p.rapidapi.com"

# ─── Kaggle ───────────────────────────────────────────────────
# Note: Kaggle credentials are typically stored in ~/.kaggle/kaggle.json
# but you can override with environment variables if needed
KAGGLE_USERNAME="your-kaggle-username"
KAGGLE_KEY="your-kaggle-api-key"

# ─── Database ─────────────────────────────────────────────────
# MongoDB
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/dbname"

# Redis
REDIS_URL="redis://localhost:6379/0"

# ─── Server Configuration ─────────────────────────────────────
SERVER_PORT="8000"
SERVER_HOST="0.0.0.0"
DEBUG="false"

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL="INFO"
LOG_FILE="logs/agentforge.log"

# ─── Agent Configuration ──────────────────────────────────────
# Default LLM Provider (openai, anthropic, gemini, vllm, ollama)
DEFAULT_LLM_PROVIDER="openai"
DEFAULT_LLM_MODEL="gpt-4o"

# vLLM Configuration (if using vLLM)
VLLM_BASE_URL="http://localhost:8000/v1"
VLLM_JWT_SECRET="your-jwt-secret"
VLLM_JWT_ALGORITHM="HS256"
VLLM_JWT_EXPIRY_MINUTES="15"

# Ollama Configuration (if using Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama2"

# ─── Security ─────────────────────────────────────────────────
# API Rate Limiting
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS_PER_MINUTE="60"

# CORS Settings
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
CORS_CREDENTIALS="true"

# JWT Settings (if using JWT authentication)
JWT_SECRET="your-jwt-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_HOURS="24"

# ─── Feature Flags ─────────────────────────────────────────────
ENABLE_MULTI_AGENT="true"
ENABLE_TOOL_EXECUTION="true"
ENABLE_MEMORY_PERSISTENCE="true"
ENABLE_WORKFLOW_ENGINE="true"

# ─── Storage ──────────────────────────────────────────────────
DATA_DIR="./data"
CACHE_DIR="./cache"
LOGS_DIR="./logs"

# ─── Webhook Configuration ────────────────────────────────────
# Webhooks for integration with external systems
WEBHOOK_ENABLED="false"
WEBHOOK_SECRET="your-webhook-secret"
WEBHOOK_URL="https://your-webhook-endpoint.com/webhook"
